# Random secret that forms the MCP URL: https://<host>/mcp/<MCP_PATH_SECRET>
# Generate: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
MCP_PATH_SECRET=
# From your Reddit app (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Format: <platform>:<app id>:<version> (by /u/<your reddit username>)
REDDIT_USER_AGENT=
